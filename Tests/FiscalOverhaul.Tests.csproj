<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the mod's pure logic (Mod/Logic). Those files have no game or Unity
    dependencies, so they're compiled straight into this modern .NET test project instead
    of referencing the net48 mod assembly (which needs the game's DLLs).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FiscalOverhaul.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Mod\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
