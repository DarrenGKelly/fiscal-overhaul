{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "src",
    "skipLibCheck": true,
    "typeRoots": ["./types"],
    "types": [],
    "resolveJsonModule": true,
    "paths": {
      "mod.json": ["../mod.json"]
    }
  },
  "include": ["src", "types"],
  // Tests run under vitest (Node), whose typings need a newer TypeScript than the game template pins.
  "exclude": ["src/**/*.test.ts", "node_modules"]
}
