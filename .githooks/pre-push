#!/bin/sh
# Enforces the branch policy (.githooks/branch-policy.sh) on every pushed ref: master only changes
# through pull requests, pushed branches must be feature/<name>, fix/<name> or autodev, and autodev
# only fast-forwards.

. "$(git rev-parse --show-toplevel)/.githooks/branch-policy.sh"

status=0
while read local_ref local_sha remote_ref remote_sha; do
    check_push_ref "$remote_ref" "$local_sha" "$remote_sha" || status=1
done

exit $status
